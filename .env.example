# Relational Database (MySQL)
DATABASE_URL="mysql://root:YOUR_MYSQL_PASSWORD@127.0.0.1:3306/university_lab_db"

# Document Database (MongoDB)
# Supports local mongod, MongoDB Atlas URI, or embedded fallback via mongodb-memory-server
MONGODB_URI="mongodb://127.0.0.1:27017/university_lab_audit"
MONGODB_DB_NAME="university_lab_audit"

# Authentication & Session Secrets
JWT_SECRET="super-secret-jwt-token-key-university-lab-resource-allocation-2026-min-32-chars"
SESSION_SECRET="session-cookie-encryption-secret-key-university-lab-allocation-2026"

# Application Environment
NODE_ENV="development"
PORT=3000
